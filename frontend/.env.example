# Dev LAN / local (recomendado): URLs relativas + proxy en vite.config.ts
# El navegador llama al mismo host:puerto del front (/api, /sanctum).
# Así funciona localhost:5173 y 192.168.101.34:5173 sin hardcodear IP en el código.
VITE_API_URL=/api
VITE_BACKEND_URL=

# Alternativa sin proxy (solo si abres el front y el API en el mismo host explícito):
# VITE_API_URL=http://192.168.101.34:8000/api
# VITE_BACKEND_URL=http://192.168.101.34:8000
