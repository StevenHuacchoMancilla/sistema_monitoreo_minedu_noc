# Dev LAN / local (recomendado): URLs relativas + proxy en vite.config.ts
# Producción Vercel: mismas URLs relativas + vercel.json (proxy a Render).
# El navegador llama al mismo host del front (/api, /sanctum) → cookies Sanctum/XSRF OK.
VITE_API_URL=/api
VITE_BACKEND_URL=

# Alternativa sin proxy (solo mismo host explícito; NO sirve Vercel↔Render):
# VITE_API_URL=http://192.168.101.34:8000/api
# VITE_BACKEND_URL=http://192.168.101.34:8000
