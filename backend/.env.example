APP_NAME="NOC Loreto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.101.34:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monitoreo_llee
DB_USERNAME=steven
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# LAN temporal: http://192.168.101.34:5173  |  local: http://localhost:5173
FRONTEND_URL=http://192.168.101.34:5173
SANCTUM_STATEFUL_DOMAINS=192.168.101.34:5173,localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
ADMIN_EMAIL=admin@noc.loreto.local
ADMIN_PASSWORD=
ADMIN_NAME="Administrador NOC"

PRTG_BASE_URL=
PRTG_API_TOKEN=
PRTG_ALLOWED_PROBE="Sonda local"
PRTG_ALLOWED_ROOT_GROUP="Operadores Global Fiber página inicial"
PRTG_DEVICE_CID_REGEX="^CID(\\d+)"
PRTG_SYNC_ENABLED=false
PRTG_SYNC_INTERVAL_SECONDS=120
PRTG_TABLE_COUNT=10000

# Hora operativa de caídas/recuperaciones = reloj del servidor al detectar (no downtimesince PRTG).
INCIDENT_USE_SYSTEM_CLOCK=false
# Re-caída dentro de N segundos reabre la misma incidencia (agrupa flaps).
INCIDENT_FLAP_REOPEN_SECONDS=900
# No crear incidencias retrospectivas desde historial PRTG (solo corrección de existentes si se aplica).
PRTG_RECONCILE_ALLOW_CREATES=false

CLOUDNET_BASE_URL=https://oasiscloudapi.h3c.com
CLOUDNET_API_KEY=
CLOUDNET_SYNC_ENABLED=false
CLOUDNET_SYNC_INTERVAL_MINUTES=5
INCIDENT_HISTORY_COALESCE_SECONDS=1800
